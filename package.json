{
  "name": "cashybank-backend",
  "version": "2.0.0",
  "description": "CashyBank API backend.",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file .env --watch src/server.ts",
    "build": "tsup src --out-dir build",
    "start": "node build/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "db:test:generate": "dotenv -e .env.test -- prisma generate",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate dev",
    "db:test:migrate:deploy": "dotenv -e .env.test -- prisma migrate deploy",
    "db:test:migrate:reset": "dotenv -e .env.test -- prisma migrate reset",
    "db:test:push": "dotenv -e .env.test -- prisma db push",
    "db:test:seed": "dotenv -e .env.test -- prisma db seed",
    "db:test:studio": "dotenv -e .env.test -- prisma studio",
    "db:test:status": "dotenv -e .env.test -- prisma migrate status",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "dotenv -e .env.test -- vitest run --project e2e",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage"
  },
  "engines": {
    "node": "24.x"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@scalar/fastify-api-reference": "^1.48.7",
    "argon2": "^0.44.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "uuidv7": "^1.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
